{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icewalk/stm.schema.json",
  "title": "Science Traceability Matrix de una EVA",
  "type": "object",
  "required": ["mission_id", "site_id", "constraints", "objectives"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string" },
    "site_id": { "type": "string" },
    "constraints": {
      "type": "object",
      "required": ["eva_max_h", "reserve", "max_slope_deg", "crew"],
      "additionalProperties": false,
      "properties": {
        "eva_max_h": { "type": "number", "exclusiveMinimum": 0 },
        "reserve": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_slope_deg": { "type": "number", "minimum": 0, "maximum": 90 },
        "walkback_max_km": { "type": "number", "exclusiveMinimum": 0 },
        "walkback_caution_min": { "type": "number", "minimum": 0, "description": "Margen de regreso (minutos, aparte de la reserva) bajo el cual el plan avisa con caution y no suma estaciones Get Ahead. Supuesto de la misión: no hay valor publicado (docs/SOURCES.md)" },
        "crew": { "type": "integer", "minimum": 1 },
        "mass_budget_kg": { "type": ["number", "null"], "minimum": 0 },
        "walking_speed_kmh": { "type": "number", "exclusiveMinimum": 0 },
        "site_min_p": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "Probabilidad mínima de hielo al alcance de una herramienta para ir al sitio con ella (tarjeta de sitio, `site_assessment` del plan). Supuesto de la misión: ni NASA ni la literatura publican un valor. Regla de decisión de prospección (Peel 2015; Rose 2001): conviene ir si p > C / (C + R), con C el costo de una EVA sin hielo y R el valor de encontrarlo; 0.5 equivale a C = R. Sin este campo, la tarjeta da números sin veredicto (docs/SOURCES.md)" }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "title", "hypothesis", "measurement"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "hypothesis": { "type": "string" },
          "purpose": { "enum": ["resource", "science", "both"] },
          "trace": { "type": "string", "description": "A qué objetivo de NASA/NASEM se traza" },
          "measurement": {
            "type": "object",
            "required": ["variable"],
            "additionalProperties": false,
            "properties": {
              "variable": { "enum": ["ice_presence", "ice_depth", "ice_purity", "surface_change", "geologic_context"] },
              "depth_max_m": { "type": "number", "minimum": 0 },
              "coverage": { "enum": ["all_terrain_units", "highest_value", "single_best_site", "targets"] },
              "min_stations": { "type": "integer", "minimum": 0 },
              "sample_return": { "type": "boolean" },
              "targets": {
                "type": "array",
                "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              }
            }
          }
        }
      }
    }
  }
}
