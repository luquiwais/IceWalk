{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icewalk/plan.schema.json",
  "title": "Plan de EVA (respuesta de POST /plan y POST /replan)",
  "type": "object",
  "required": ["mission_id", "plan_id", "stations", "route", "timeline", "summary"],
  "properties": {
    "mission_id": { "type": "string" },
    "plan_id": { "type": "string" },
    "replanned_from": { "type": ["string", "null"] },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "position", "priority", "objective_ranks", "tools", "tasks", "duration_min", "hypothesis", "p_ice", "uncertainty", "value"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "lonlat": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "priority": { "enum": ["high", "medium", "low"] },
          "objective_ranks": { "type": "array", "items": { "type": "integer" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "tasks": {
            "type": "object",
            "properties": {
              "EV1": { "type": "array", "items": { "type": "string" } },
              "EV2": { "type": "array", "items": { "type": "string" } }
            }
          },
          "duration_min": { "type": "number", "minimum": 0 },
          "hypothesis": { "type": "string" },
          "p_ice": { "type": "number", "minimum": 0, "maximum": 1, "description": "P(profundidad del hielo ≤ umbral de la STM), del GP" },
          "uncertainty": { "type": "number", "minimum": 0, "maximum": 1, "description": "Entropía en bits de P(hielo ≤ umbral): 0 = se sabe, 1 = máxima ambigüedad" },
          "value": { "type": "number", "minimum": 0, "maximum": 1, "description": "Valor de medir de gp.planning.rank_candidates; ordena igual que 'potencial + incertidumbre'" },
          "planetary_protection": { "enum": ["none", "sensitive"] },
          "terrain_unit": { "type": "integer" },
          "kind": { "enum": ["survey", "target"], "description": "survey: elegida por el mapa de hielo; target: posición fija de la STM" },
          "depth_median_m": { "type": "number", "minimum": 0, "description": "Mediana de la profundidad del hielo según el GP" },
          "depth_shallow_m": { "type": "number", "minimum": 0, "description": "Profundidad optimista: un desvío más somera que la media de log d" }
        }
      }
    },
    "route": {
      "type": "object",
      "description": "GeoJSON FeatureCollection; coordenadas en lon/lat este",
      "required": ["type", "features"]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t_start_min", "t_end_min", "kind", "label"],
        "properties": {
          "t_start_min": { "type": "number" },
          "t_end_min": { "type": "number" },
          "kind": { "enum": ["egress", "traverse", "station", "ingress", "reserve"] },
          "label": { "type": "string" },
          "station_id": { "type": ["string", "null"] },
          "walkback_margin_min": { "type": "number" }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "description": "Qué hacer tras medir en las primeras estaciones de hielo (cuestión 23, opción C). Recomendación con justificación: decide la tripulación",
      "items": {
        "type": "object",
        "required": ["station_id", "decide_by_min", "default_option", "options"],
        "additionalProperties": false,
        "properties": {
          "station_id": { "type": "string" },
          "decide_by_min": { "type": "number", "minimum": 0, "description": "Bingo time: hora más tarde (min desde el inicio de la EVA) para dejar la estación con margen de regreso ≥ 0" },
          "hard_stop": { "type": "string", "description": "Condiciones que cortan la EVA sin importar el resultado" },
          "default_option": { "type": "integer", "minimum": 1, "description": "Rango de la opción a seguir si no hay decisión a tiempo" },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["rank", "if_result", "next_station_ids", "rationale"],
              "additionalProperties": false,
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "if_result": { "enum": ["ice", "no_ice", "inconclusive", "any"], "description": "any: el resultado no cambia las estaciones siguientes" },
                "probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Chance del resultado según el GP; null si no se estima" },
                "next_station_ids": { "type": "array", "items": { "type": "string" } },
                "next_stations": {
                  "type": "array",
                  "description": "Estaciones de esta opción que no están en el plan nominal",
                  "items": {
                    "type": "object",
                    "required": ["id", "position"],
                    "properties": {
                      "id": { "type": "string" },
                      "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                      "lonlat": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                      "p_ice": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                },
                "rationale": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "count"],
        "properties": {
          "tool": { "type": "string" },
          "count": { "type": "integer" },
          "mass_kg": { "type": ["number", "null"] },
          "justification": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["duration_min", "distance_km", "expected_uncertainty_reduction"],
      "properties": {
        "duration_min": { "type": "number" },
        "distance_km": { "type": "number" },
        "max_distance_from_habitat_km": { "type": "number" },
        "min_walkback_margin_min": { "type": "number" },
        "dose_estimate_msv": { "type": "number" },
        "expected_uncertainty_reduction": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fracción de la incertidumbre espacial de la zona alcanzable (la capa uncertainty de map.schema.json, sumada sobre las candidatas) que el plan espera sacar, con cada estación supuesta medida en su valor esperado. Chica por construcción: una estación informa ~100 m alrededor" },
        "walkback_caution_min": { "type": "number", "minimum": 0, "description": "Umbral de caution del margen de regreso, copiado de la STM; la web lo dibuja en la curva de walkback margin" },
        "ice_threshold_m": { "type": "number", "exclusiveMinimum": 0, "description": "Umbral de profundidad de la STM para P(hielo)" },
        "craters_in_model": { "type": "integer", "minimum": 0, "description": "Cráteres del catálogo en el GP; 0 = solo el prior" },
        "crew": { "type": "integer" },
        "is_mock": { "type": "boolean" }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": { "enum": ["advisory", "caution", "warning"] },
          "message": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "site_assessment": {
      "type": "object",
      "description": "Tarjeta de sitio, nivel región: P(hielo al alcance) por herramienta antes de ir, con el prior regional por latitud (gp.regional.site_assessment, Daubar 2022). No usa los cráteres del sitio ni las mediciones. Veredicto solo si la STM declara constraints.site_min_p: GO si todo el intervalo del 90 % la supera, NO_GO si queda todo debajo, CONDITIONAL si la cruza; el sitio toma el de la mejor herramienta. Sin datos regionales, INSUFFICIENT_DATA",
      "required": ["lat_deg", "status", "warnings", "tools"],
      "additionalProperties": false,
      "properties": {
        "lat_deg": { "type": "number" },
        "status": { "enum": ["ok", "extrapolated", "no_data"] },
        "median_depth_m": { "type": "number", "exclusiveMinimum": 0, "description": "Mediana regional de la profundidad a la tabla de hielo" },
        "median_depth_90_m": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "sd_log_total": { "type": "number", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "tools": {
          "type": "object",
          "description": "Por id de herramienta del catálogo (las que miden bajo la superficie)",
          "additionalProperties": {
            "type": "object",
            "required": ["depth_m", "p_ice", "p_ice_90"],
            "additionalProperties": false,
            "properties": {
              "depth_m": { "type": "number", "exclusiveMinimum": 0 },
              "p_ice": { "type": "number", "minimum": 0, "maximum": 1 },
              "p_ice_90": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 },
              "verdict": { "enum": ["GO", "CONDITIONAL", "NO_GO"] }
            }
          }
        },
        "verdict": { "enum": ["GO", "CONDITIONAL", "NO_GO", "INSUFFICIENT_DATA"] },
        "min_p": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "nearby_impacts": {"type": "object", "description": "Control local: impactos nuevos de Daubar 2022 a ±10° de latitud y ±30° de longitud, con hielo observado contra esperado por el prior de latitud (dentro de la muestra). Si sobran (z >= 2), warnings avisa que el hielo probablemente está más somero", "required": ["window_deg", "n", "ice", "expected_ice", "z"], "additionalProperties": false, "properties": {"window_deg": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "n": {"type": "integer", "minimum": 0}, "ice": {"type": "integer", "minimum": 0}, "expected_ice": {"type": "number", "minimum": 0}, "z": {"type": ["number", "null"]}}}
      }
    }
  }
}
