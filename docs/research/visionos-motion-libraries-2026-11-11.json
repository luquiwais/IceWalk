  "decision": {
    "chosen": "Motion spring generator with WAAPI playback",
    "reason": "Replace custom physics/termination while preserving geometry/material separation and avoiding a JS style write loop per frame.",
    "deferred": "MotionValues/styleEffect only for a concrete live-value use case; Flubber or MorphSVG only for a concrete mismatched-topology morph.",
    "generatorCaveats": [
      "next and direct duration use milliseconds; visualDuration uses seconds.",
      "Physics/visualDuration preserve supplied velocity; duration springs discard it.",
      "Pass bounce:0 explicitly with visualDuration in direct generator version14.12.0.",
      "next reuses a mutable state object; snapshot primitive values.",
      "velocity and retarget are optional on exported KeyframeGenerator type and present on tested spring.",
